{% render 'partials/head.liquid' %}

<main>
    <div class="card">
        <div class="inner-card">
            <section class="front-card">
                <img class="profile-pic" src="/Squad1I-Tin.JPG" width="250px">
                <h1>{{ person.name }}</h1>
                <p class="front-heading">{{ person.custom.front.heading }}</p>
                <p class="school">{{ person.custom.front.school }}</p>
            </section>

            <section class="back-card">
                <h2>{{ person.name }}</h2>

                <section class="about-me">
                    <h3>{{person.custom.back.about_me}}</h3>
                    <ul class="about-list">
                        <li>
                        <button class="about-me-button">
                            <img src="{{ person.custom.images.age }}" width="50px">
                            {{ person.custom.images_text.age }}
                            </button> 
                        </li>
                        <li>
                        <button class="about-me-button">
                            <img src="{{ person.custom.images.location }}" width="50px">
                            {{ person.custom.images_text.location }}
                            </button> 
                        </li>
                        <li>
                        <button class="about-me-button">
                            <img src="{{ person.custom.images.education }}" width="50px">
                            {{ person.custom.images_text.education1 }}
                            </button> 
                        </li>
                        <li>
                        <button class="about-me-button">
                            <img src="{{ person.custom.images.education }}" width="50px">
                            {{ person.custom.images_text.education2 }}
                            </button> 
                        </li>
                    </ul>
                </section>

                <section class="hobby">
                    <h3>{{ person.custom.back.hobby }}</h3>
                    <ul class="hobby-list">
                        <li>
                            <button class="hobby-button">
                            <img src="{{ person.custom.images.gaming }}" width="50px">
                            {{ person.custom.images_text.gaming }}
                            </button> 
                        </li>
                        <li>
                            <button class="hobby-button">
                            <img src="{{ person.custom.images.fitness }}" width="50px">
                            {{ person.custom.images_text.fitness }}
                            </button> 
                        </li>
                        <li>
                            <button class="hobby-button">
                            <img src="{{ person.custom.images.series }}" width="50px">
                            {{ person.custom.images_text.series }}
                            </button> 
                        </li>
                    </ul>
                </section>

                <span class="socials">
                    <ul class="socials-list">
                        <li>
                            <a href="{{person.custom.social_links.instagram}}"><img src="{{ person.custom.images.instagram }}" width="50px"></a>
                        </li>
                        <li>
                            <a href="{{ person.custom.social_links.github }}"><img src="{{ person.custom.images.github }}" width="30px"></a>
                        </li>
                        <li>
                            <a href="{{ person.custom.social_links.linkedin }}"><img src="{{ person.custom.images.linkedin }}" width="50px"></a>
                        </li>
                    </ul>
                </span>
            </section>
        </div>
    </div>
</main>

{% render 'partials/foot.liquid' %}
